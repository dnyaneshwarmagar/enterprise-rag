# OpenAI LLM (Guardrails + RAG generation via Portkey)
OPENAI_API_KEY=

# Portkey LLM Gateway
PORTKEY_API_KEY=
PORTKEY_PRIMARY_SLUG=marathon-api
PORTKEY_FALLBACK_SLUG=anthropic-fallback
PORTKEY_PRIMARY_CONFIG_ID=

# Jina AI Embeddings + Reranker API
JINA_API_KEY=

# Qdrant Vector DB Settings
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=

# S3 document storage. Leave S3_BUCKET empty to read and write files on disk only.
# When S3_BUCKET is set, `python -m app.ingestion.processor` reads s3://bucket/S3_PREFIX.
# boto3 reads AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY from the environment.
S3_BUCKET=
S3_PREFIX=documents
S3_PROCESSED_PREFIX=processed
# AWS_REGION=us-east-1

# Production persistence (Neon serverless Postgres) & cache (Upstash Redis)
NEON_DB_URL=postgresql://user:password@host.neon.tech/enterprise_rag?sslmode=require
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# API safety
RAG_API_KEY=
# Roles for RAG_API_KEY. Use * to read every document.
RAG_API_KEY_ROLES=*
# Limited tokens. The UI can offer these by role name; the token stays on the server.
# RAG_ROLE_KEYS=employee-token=employee;hr-token=hr,manager
DEFAULT_ACCESS_ROLES=employee
DEFAULT_DOCUMENT_ROLES=employee
ACCESS_POLICY_PATH=access_policy.json
# UI demo. Normal demo is employee. RBAC demo may pick one of these roles.
RBAC_DEMO=true
RBAC_DEMO_ROLES=employee,hr,manager
# Manager upload and delete in the UI. Set false to disable the buttons.
DOCUMENT_ADMIN_ENABLED=false
RATE_LIMIT_PER_MINUTE=20

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag_scale_test

# Backend URL for Streamlit chat + evals (server-side HTTP; keep localhost on EC2)
BACKEND_URL=http://127.0.0.1:8000
# Public paths via nginx (after bootstrap):
#   http://<public-ip>/           chat UI
#   http://<public-ip>/evals/     evals UI
#   http://<public-ip>/api/health FastAPI

# Judge LLM for RAGAS evals (falls back to OPENAI_API_KEY if not set)
# Full RAGAS Step 3 on EC2: pip install -r requirements-evals.txt
JUDGE_OPENAI_API_KEY=
